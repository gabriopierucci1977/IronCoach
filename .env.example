AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_base_id
OPENAI_API_KEY=your_openai_api_key

# Soglie opzionali di freschezza dati.
# Valori assenti, non interi o negativi usano i default.
IRONCOACH_RECOVERY_MAX_AGE_DAYS=3
IRONCOACH_TRAINING_MAX_AGE_DAYS=7

# Cap opzionali della confidenza per dati non aggiornati.
# Valori assenti, non interi, minori di 0 o maggiori di 100
# usano i default.
IRONCOACH_FRESHNESS_HIGH_CONFIDENCE_CAP=75
IRONCOACH_FRESHNESS_MODERATE_CONFIDENCE_CAP=85